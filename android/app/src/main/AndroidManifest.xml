<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para saber la red de la tablet y buscar a Javbots si la PC cambia de IP. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Imágenes de fondo (Pictures/Letras/fondos). En Android 5.1 se concede al instalar. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Letras">

        <!-- singleTask: al volver de Firefox tras iniciar sesión se reutiliza la misma pantalla. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Protector de pantalla (Daydream): la misma pantalla cuando la tablet carga sin usarse. -->
        <service
            android:name=".Protector"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
