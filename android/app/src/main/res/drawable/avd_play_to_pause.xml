<?xml version="1.0" encoding="utf-8"?>
<!-- Transformación del ícono del botón de play, con media vuelta (las barras de pausa se ven igual giradas). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/vd_play">
    <target android:name="shape">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="320"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="pathData"
                android:valueFrom="M8,5 L8,19 L13.5,15.5 L13.5,8.5 Z M13.5,8.5 L13.5,15.5 L19,12 L19,12 Z"
                android:valueTo="M6,5 L6,19 L10,19 L10,5 Z M14,5 L14,19 L18,19 L18,5 Z"
                android:valueType="pathType" />
        </aapt:attr>
    </target>
    <target android:name="g">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="320"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="180" />
        </aapt:attr>
    </target>
</animated-vector>
