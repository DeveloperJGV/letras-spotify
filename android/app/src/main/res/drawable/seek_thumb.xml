<?xml version="1.0" encoding="utf-8"?>
<!-- Bolita de la barra: chica, y grande mientras se arrastra (mismo tamaño total para que no brinque). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="200">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <size android:width="22dp" android:height="22dp" />
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="5dp" android:color="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <inset android:inset="5dp">
            <shape android:shape="oval">
                <size android:width="12dp" android:height="12dp" />
                <solid android:color="#FFFFFFFF" />
            </shape>
        </inset>
    </item>
</selector>
