<?xml version="1.0" encoding="utf-8"?>
<!-- Capas, de atrás hacia adelante: cielo, imágenes, velo para leer, letra, encabezado, reloj, botones, perros.
     La usan la app y el protector de pantalla (Pantalla.kt). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <dev.jgv.letras.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fondo de imágenes: una carpeta de Pictures/Letras/fondos (Lofi, Boda…); cubre al cielo. -->
    <dev.jgv.letras.ArtView
        android:id="@+id/art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />


    <!-- Oscurece el fondo mientras hay letra, para que se lea sobre un cielo de día. -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/scrim" />

    <!-- Piso oscuro detrás de los controles y los perros: se leen sobre cualquier fondo. -->
    <View
        android:id="@+id/floor"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="bottom"
        android:background="@drawable/floor_background" />

    <!-- Entre el encabezado y los controles: los márgenes los pone Pantalla.kt al medir. -->
    <ScrollView
        android:id="@+id/lyricsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadingEdgeLength="64dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/lyricsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp" />
    </ScrollView>

    <!-- Canción en curso: portada, título y artista. Mantener presionado para cerrar sesión. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="168dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Pantalla de espera: reloj y mensajes (sin sesión, nada sonando, errores). -->
    <LinearLayout
        android:id="@+id/idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Hora con brillo según el cielo y fecha abajo (ClockView.kt). -->
        <dev.jgv.letras.ClockView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <!-- Tarjeta de datos que va rotando: clima, cielo, un día como hoy, datos geek, cosas bonitas (Datos.kt). -->
        <!-- Alto fijo (hasta tres renglones): al cambiar de tarjeta, el reloj no brinca. -->
        <FrameLayout
            android:id="@+id/datoBox"
            android:layout_width="wrap_content"
            android:layout_height="112dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">

        <LinearLayout
            android:id="@+id/dato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/dato_background"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/datoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/datoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-light"
                android:lineSpacingExtra="2dp"
                android:maxWidth="440dp"
                android:shadowColor="#99000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
        </LinearLayout>
        </FrameLayout>


        <Button
            android:id="@+id/connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/accent"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/connect"
            android:textColor="@color/background"
            android:visibility="gone" />

        <TextView
            android:id="@+id/connectHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:text="@string/connect_hint"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- A los lados del reloj: el clima a la izquierda y la pila a la derecha. Con imágenes de fondo suben a las
         esquinas de arriba (Pantalla.layoutSides). -->
    <dev.jgv.letras.WeatherView
        android:id="@+id/weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Batería de la tablet: pila que se llena, burbujas y rayo al cargar (BatteryView.kt). -->
    <dev.jgv.letras.BatteryView
        android:id="@+id/battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Firma de la marca: discreta, arriba a la izquierda, solo en la pantalla de espera. -->
    <TextView
        android:id="@+id/brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:alpha="0.8"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.35"
        android:shadowColor="#99000000"
        android:shadowRadius="4"
        android:text="@string/brand"
        android:textColor="@color/aviva_gold"
        android:textSize="13sp" />

    <!-- Crédito del fondo de artista y una flechita discreta para pasar a la siguiente imagen. Todo el renglón se
         puede tocar. Va en la esquina, arriba de los perros. -->
    <LinearLayout
        android:id="@+id/credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="6dp"
        android:alpha="0.75"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/next_art"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/creditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#CC000000"
            android:shadowRadius="4"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <!-- Botones siempre a la vista: ayuda, fondo, opciones (y salir en el protector). -->
    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnHelp"
            style="@style/RoundButton"
            android:contentDescription="@string/help_title"
            android:src="@drawable/ic_help" />
        <ImageButton
            android:id="@+id/btnBackground"
            style="@style/RoundButton"
            android:contentDescription="@string/bg_button"
            android:src="@drawable/ic_wallpaper" />
        <ImageButton
            android:id="@+id/btnOptions"
            style="@style/RoundButton"
            android:contentDescription="@string/opt_title"
            android:src="@drawable/ic_more" />
        <ImageButton
            android:id="@+id/btnExit"
            style="@style/RoundButton"
            android:contentDescription="@string/exit"
            android:src="@drawable/ic_close"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Controles de la música: una píldora flotante arriba de los perros (por Javbots o la API de Spotify).
         Sonando, se esconde sola y vuelve al tocar la pantalla; el ancho lo pone Pantalla.kt. -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="6dp"
        android:background="@drawable/pill_background"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrevious"
                style="@style/PillButton"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_previous" />
            <ImageButton
                android:id="@+id/playPause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/play_button"
                android:contentDescription="@string/play_pause"
                android:elevation="4dp"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/vd_pause" />
            <ImageButton
                android:id="@+id/btnNext"
                style="@style/PillButton"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_next" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:minWidth="12dp" />

            <!-- Tocar la bocina: silencio (y otra vez, de regreso). -->
            <ImageButton
                android:id="@+id/volumeIcon"
                style="@style/PillButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:alpha="0.8"
                android:contentDescription="@string/mute"
                android:src="@drawable/ic_volume_up" />
            <!-- El volumen: el cuarto de Hunter y Tango con una lupa de vidrio que se arrastra (VolumeCapsule.kt). -->
            <dev.jgv.letras.VolumeCapsule
                android:id="@+id/volumeCapsule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/volume" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/elapsed"
                style="@style/PillTime"
                android:gravity="end" />
            <SeekBar
                android:id="@+id/progressBar"
                style="@style/PillSeek"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:max="1000" />
            <TextView
                android:id="@+id/total"
                style="@style/PillTime"
                android:gravity="start" />
        </LinearLayout>
    </LinearLayout>

    <dev.jgv.letras.DogsView
        android:id="@+id/dogs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingBottom="8dp" />
</FrameLayout>
